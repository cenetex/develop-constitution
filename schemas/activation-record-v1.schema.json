{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://github.com/cenetex/develop-constitution/schemas/activation-record-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_envelope_digest": {
      "$ref": "#/$defs/digest"
    },
    "api_version": {
      "const": "develop.cenetex/v1"
    },
    "candidate_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "installed_at": {
      "format": "date-time",
      "type": "string"
    },
    "installer_principal": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "ActivationRecord"
    },
    "posture_digest": {
      "$ref": "#/$defs/digest"
    },
    "previous_activation_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "previous_manifest_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "result": {
      "const": "active"
    },
    "rollback_artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "target_id": {
      "const": "develop-policy-store"
    },
    "trust_root_digest": {
      "$ref": "#/$defs/digest"
    },
    "workspace_id": {
      "const": "develop"
    }
  },
  "required": [
    "api_version",
    "kind",
    "workspace_id",
    "target_id",
    "sequence",
    "previous_activation_digest",
    "previous_manifest_digest",
    "candidate_manifest_digest",
    "posture_digest",
    "trust_root_digest",
    "activation_envelope_digest",
    "installer_principal",
    "installed_at",
    "rollback_artifact_digest",
    "result"
  ],
  "title": "Constitution Activation Record v1",
  "type": "object"
}
