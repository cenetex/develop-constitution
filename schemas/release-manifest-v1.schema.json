{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "file": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "0o444"
          ]
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "type": {
          "const": "regular"
        }
      },
      "required": [
        "type",
        "sha256",
        "byte_length",
        "mode"
      ],
      "type": "object"
    },
    "sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "$id": "https://github.com/cenetex/develop-constitution/schemas/release-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "develop.cenetex/v1"
    },
    "canonicalization": {
      "const": "sorted-keys-utf8-no-whitespace-v1"
    },
    "constitution_document_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "files": {
      "additionalProperties": {
        "$ref": "#/$defs/file"
      },
      "minProperties": 18,
      "propertyNames": {
        "enum": [
          "CONSTITUTION.md",
          "constitution/v1/constitution.json",
          "constitution/v1/risk-rules.json",
          "deployments/develop/posture.json",
          "schemas/activation-record-v1.schema.json",
          "schemas/amendment-v1.schema.json",
          "schemas/capability-grant-v1.schema.json",
          "schemas/constitution-v1.schema.json",
          "schemas/control-attestation-v1.schema.json",
          "schemas/exception-v1.schema.json",
          "schemas/maturity-promotion-v1.schema.json",
          "schemas/posture-v1.schema.json",
          "schemas/release-manifest-v1.schema.json",
          "schemas/risk-rules-v1.schema.json",
          "schemas/signature-envelope-v1.schema.json",
          "schemas/trust-root-v1.schema.json",
          "tools/constitutionctl.py",
          "trust/root.json"
        ]
      },
      "required": [
        "CONSTITUTION.md",
        "constitution/v1/constitution.json",
        "constitution/v1/risk-rules.json",
        "deployments/develop/posture.json",
        "schemas/activation-record-v1.schema.json",
        "schemas/amendment-v1.schema.json",
        "schemas/capability-grant-v1.schema.json",
        "schemas/constitution-v1.schema.json",
        "schemas/control-attestation-v1.schema.json",
        "schemas/exception-v1.schema.json",
        "schemas/maturity-promotion-v1.schema.json",
        "schemas/posture-v1.schema.json",
        "schemas/release-manifest-v1.schema.json",
        "schemas/risk-rules-v1.schema.json",
        "schemas/signature-envelope-v1.schema.json",
        "schemas/trust-root-v1.schema.json",
        "tools/constitutionctl.py",
        "trust/root.json"
      ],
      "type": "object"
    },
    "kind": {
      "const": "ReleaseManifest"
    },
    "predecessor_manifest_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "revision": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "source_commit": {
      "$ref": "#/$defs/sha"
    },
    "source_repository": {
      "const": "cenetex/develop-constitution"
    },
    "source_tree": {
      "$ref": "#/$defs/sha"
    },
    "target_id": {
      "const": "develop-policy-store"
    },
    "workspace_id": {
      "const": "develop"
    }
  },
  "required": [
    "api_version",
    "kind",
    "workspace_id",
    "target_id",
    "sequence",
    "predecessor_manifest_digest",
    "revision",
    "source_repository",
    "source_commit",
    "source_tree",
    "constitution_document_digest",
    "canonicalization",
    "created_at",
    "files"
  ],
  "title": "Constitution Release Manifest v1",
  "type": "object"
}
