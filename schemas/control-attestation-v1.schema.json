{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://github.com/cenetex/develop-constitution/schemas/control-attestation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "pattern": "^[a-z][a-z0-9_.-]+$",
      "type": "string"
    },
    "constitution_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "control_id": {
      "pattern": "^[a-z][a-z0-9-]+$",
      "type": "string"
    },
    "environment_digest": {
      "$ref": "#/$defs/digest"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "implementation_digest": {
      "$ref": "#/$defs/digest"
    },
    "observed_at": {
      "format": "date-time",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "result": {
      "const": "pass"
    },
    "risk_class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "runner_identity": {
      "minLength": 1,
      "type": "string"
    },
    "test_evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "verifier_identity": {
      "minLength": 1,
      "type": "string"
    },
    "verifier_signature_envelope_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "constitution_manifest_digest",
    "control_id",
    "implementation_digest",
    "environment_digest",
    "repository",
    "risk_class",
    "capability",
    "runner_identity",
    "verifier_identity",
    "test_evidence_digest",
    "result",
    "observed_at",
    "expires_at",
    "verifier_signature_envelope_digest"
  ],
  "title": "Independent Control Attestation v1",
  "type": "object"
}
