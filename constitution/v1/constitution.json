      "fail_mode": "deny",
      "kind": "preventive",
      "owner": "security_custodian"
    },
    "policy-validation": {
      "enforcement_point": "admission",
      "fail_mode": "deny",
      "kind": "preventive",
      "owner": "security_custodian"
    },
    "private-task-clone": {
      "enforcement_point": "task-launch",
      "fail_mode": "deny",
      "kind": "preventive",
      "owner": "control_plane"
    },
    "repository-rules": {
      "enforcement_point": "github",
      "fail_mode": "deny",
      "kind": "preventive",
