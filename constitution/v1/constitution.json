        "credential_class",
        "operation",
        "resource",
        "expires_at"
      ]
    },
    "deployment.execute": {
      "brokered": true,
      "effect": "external_write",
      "external": true,
      "maximum_ttl_seconds": 900,
      "required_bindings": [
        "task_id",
        "environment",
        "artifact_digest",
        "operation",
        "expires_at"
      ]
    },
    "evidence.attest": {
      "brokered": true,
      "effect": "attest",
      "external": false,
      "maximum_ttl_seconds": 3600,
      "required_bindings": [
