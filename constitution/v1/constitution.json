  "clauses": {
    "C-001": {
      "accountable_role": "security_custodian",
      "article": "Supremacy and fail-closed operation",
      "control_ids": [
        "policy-validation"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "high"
      },
      "strength": "MUST",
      "subjects": [
        "control_plane",
        "publication_broker",
        "merge_controller"
      ],
      "test_ids": [
        "ADV-UNKNOWN-DENY"
      ],
      "text": "When policy, enforcement, evidence, or identity is missing, ambiguous, stale, or invalid, the more restrictive decision applies.",
      "unwaivable": true
    },
    "C-002": {
      "accountable_role": "security_custodian",
      "article": "Worker credential boundary",
      "control_ids": [
        "worker-identity-boundary",
        "default-deny-runtime"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST_NOT",
      "subjects": [
        "control_plane",
        "worker"
      ],
      "test_ids": [
        "ADV-NO-WORKER-CREDENTIALS"
      ],
      "text": "A worker must never receive credentials, the control-plane environment, signing material, or an ambient external capability.",
      "unwaivable": true
    },
    "C-003": {
      "accountable_role": "platform_administrator",
      "article": "Workspace isolation",
      "control_ids": [
        "worker-identity-boundary",
        "private-task-clone"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST_NOT",
      "subjects": [
        "worker"
      ],
      "test_ids": [
        "ADV-NO-CANONICAL-WRITE"
      ],
      "text": "A worker must not write canonical repositories, shared Git metadata, governance, main, repository settings, another task, or control-plane state.",
      "unwaivable": true
    },
    "C-004": {
      "accountable_role": "human_owner",
      "article": "Terminal task lifecycle",
      "control_ids": [
        "lease-revocation"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "high"
      },
      "strength": "MUST",
      "subjects": [
        "control_plane"
      ],
      "test_ids": [
        "ADV-TERMINAL-LEASE"
      ],
      "text": "Expired, failed, cancelled, and merged tasks are terminal; retries require a new task identity, clone, lease, and capability set.",
      "unwaivable": true
    },
    "C-005": {
      "accountable_role": "security_custodian",
      "article": "Independent evidence",
      "control_ids": [
        "independent-verification",
        "sha-bound-publication"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST",
      "subjects": [
        "verifier",
        "publication_broker",
        "merge_controller"
      ],
      "test_ids": [
        "ADV-STALE-SHA-DENY"
      ],
      "text": "Publication, merge, and deployment require independently generated evidence bound to the exact base SHA, head SHA, environment digest, and constitution digest.",
      "unwaivable": true
    },
    "C-006": {
      "accountable_role": "security_custodian",
      "article": "Separation of duties",
      "control_ids": [
        "independent-verification",
        "repository-rules"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST_NOT",
      "subjects": [
        "worker",
        "control_plane"
      ],
      "test_ids": [
        "ADV-NO-SELF-REVIEW"
      ],
      "text": "A producing worker must not verify, review, approve, publish, merge, deploy, or activate its own work.",
      "unwaivable": true
    },
    "C-007": {
      "accountable_role": "security_custodian",
      "article": "Capability scope",
      "control_ids": [
        "capability-broker",
        "append-only-audit"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST",
      "subjects": [
        "control_plane",
        "publication_broker",
        "merge_controller"
      ],
      "test_ids": [
        "ADV-INCOMPLETE-GRANT-DENY"
      ],
      "text": "Every non-human capability is explicit, narrowly bound, time-limited, revocable, audited, and denied when any required binding is absent.",
      "unwaivable": true
    },
    "C-008": {
      "accountable_role": "platform_administrator",
      "article": "Publication boundary",
      "control_ids": [
        "capability-broker",
        "sha-bound-publication",
        "serialized-merge"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST_NOT",
      "subjects": [
        "worker"
      ],
      "test_ids": [
        "ADV-WORKER-PUBLICATION-DENY"
      ],
      "text": "Workers must never push, open pull requests, merge, deploy, change repository settings, or hold credentials that permit those actions.",
      "unwaivable": true
    },
    "C-009": {
      "accountable_role": "human_owner",
      "article": "No self-promotion",
      "control_ids": [
        "maturity-ratification"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST_NOT",
      "subjects": [
        "control_plane",
        "worker",
        "publication_broker",
        "merge_controller"
      ],
      "test_ids": [
        "ADV-NO-SELF-PROMOTION"
      ],
      "text": "No agent, service, control plane, or worker may approve or activate an increase in its own authority.",
      "unwaivable": true
    },
    "C-010": {
      "accountable_role": "security_custodian",
      "article": "Constitutional amendment",
      "control_ids": [
        "constitutional-release",
        "maturity-ratification"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST",
      "subjects": [
        "human_owner",
        "security_custodian",
        "platform_administrator"
      ],
      "test_ids": [
        "ADV-PREDECESSOR-GOVERNS"
      ],
      "text": "An amendment is evaluated under the previously active constitution and binds its base manifest digest, candidate digest, independent review, human approvals, and activation delay.",
      "unwaivable": true
    },
    "C-011": {
      "accountable_role": "security_custodian",
      "article": "Audit integrity",
      "control_ids": [
        "append-only-audit"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST",
      "subjects": [
        "control_plane",
        "publication_broker",
        "merge_controller",
        "platform_administrator"
      ],
      "test_ids": [
        "ADV-AUDIT-GAP-DENY"
      ],
      "text": "Every privileged action and lifecycle transition is linked to a task, change, or incident and appended to tamper-evident audit history; audit failure denies the action.",
      "unwaivable": true
    },
    "C-012": {
      "accountable_role": "security_custodian",
      "article": "Human-only break glass",
      "control_ids": [
        "break-glass-control"
      ],
      "on_violation": {
        "decision": "deny",
        "demote_to": "L0",
        "incident_severity": "critical"
      },
      "strength": "MUST_NOT",
      "subjects": [
        "human_owner",
        "platform_administrator",
        "worker"
      ],
      "test_ids": [
        "ADV-BREAK-GLASS-HUMAN-ONLY"
      ],
      "text": "Break-glass authority must not be delegated to a worker and cannot waive another unwaivable clause.",
      "unwaivable": true
    }
  },
  "control_attestation_policy": {
    "independent_verifier_required": true,
    "maximum_age_seconds": 86400,
    "required_bindings": [
      "constitution_manifest_digest",
      "control_id",
      "implementation_digest",
      "environment_digest",
      "repository",
      "risk_class",
      "capability",
      "runner_identity",
      "verifier_identity",
      "test_evidence_digest",
      "result",
      "observed_at",
      "expires_at",
      "verifier_signature_envelope_digest"
    ],
    "required_for_active_maturity": true,
    "schema": "schemas/control-attestation-v1.schema.json"
  },
  "controls": {
    "append-only-audit": {
      "enforcement_point": "every-privileged-action",
      "fail_mode": "deny",
      "kind": "preventive",
      "owner": "security_custodian"
