        "repository",
        "pull_request",
        "base_sha",
        "head_sha",
        "expires_at"
      ]
    },
    "github.pull_request.create": {
      "brokered": true,
      "effect": "external_write",
      "external": true,
      "maximum_ttl_seconds": 900,
