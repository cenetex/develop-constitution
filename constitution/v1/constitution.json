  "defaults": {
    "control_failure": "deny",
    "decision": "deny",
    "signature_failure": "deny",
    "unknown_capability": "deny",
    "unknown_risk": "R3"
  },
  "exception_policy": {
    "maximum_ttl_seconds": 14400,
    "renewal": "new-proposal-required",
    "requires_detached_human_approval": true,
    "requires_exact_scope": true,
    "unwaivable_clause_exceptions": "deny"
  },
  "incident_policy": {
    "credential_rotation_after_break_glass": true,
    "postmortem_deadline_seconds": 259200,
    "restoration_requires_independent_review": true,
    "suspected_boundary_failure": "freeze-and-demote-L0"
  },
  "invariant": "A malicious, compromised, or incompetent worker may produce bad code, but cannot escape its task boundary, obtain ambient authority, falsify acceptance evidence, alter governance, or publish a change.",
  "kind": "Constitution",
  "lifecycle": {
    "initial_state": "queued",
    "states": [
      "queued",
      "admitted",
      "leased",
      "running",
      "verifying",
      "review",
      "merge-ready",
      "merged",
      "failed",
      "cancelled",
      "expired"
    ],
    "terminal_states": [
      "merged",
      "failed",
      "cancelled",
      "expired"
    ],
    "transitions": {
      "admitted": [
        "leased",
        "cancelled"
      ],
      "cancelled": [],
      "expired": [],
      "failed": [],
      "leased": [
        "running",
        "cancelled",
        "expired"
      ],
      "merge-ready": [
        "merged",
        "failed",
        "cancelled",
        "expired"
      ],
      "merged": [],
      "queued": [
        "admitted",
        "cancelled"
      ],
      "review": [
        "merge-ready",
        "failed",
        "cancelled",
        "expired"
      ],
      "running": [
        "verifying",
        "failed",
        "cancelled",
        "expired"
      ],
      "verifying": [
        "review",
        "failed",
        "cancelled",
        "expired"
      ]
    }
  },
  "maturity_levels": {
    "L0": {
      "authority": "Read-only analysis and disposable experiments; a human mediates every publication.",
      "maximum_autonomous_mutation_risk": "none",
      "minimum_governed_tasks": 0,
      "minimum_observation_days": 0,
      "name": "quarantine",
      "nonhuman_capability_ceiling": [
        "repository.read"
      ],
      "promotion_approvals": 2,
      "rank": 0,
      "required_controls": []
    },
    "L1": {
      "authority": "A worker may edit, execute tests, and produce a candidate commit only in a private task clone without network or credentials.",
      "maximum_autonomous_mutation_risk": "R1",
      "minimum_adversarial_tests": 25,
      "minimum_governed_tasks": 0,
      "minimum_observation_days": 0,
      "name": "contained-worker",
      "nonhuman_capability_ceiling": [
        "repository.read",
        "task_clone.write",
        "candidate.execute",
        "git.commit",
        "task.admit",
        "lease.manage",
        "capability.grant",
        "evidence.attest",
        "audit.append"
      ],
      "promotion_approvals": 2,
      "rank": 1,
      "required_controls": [
        "worker-identity-boundary",
        "private-task-clone",
        "default-deny-runtime",
        "lease-revocation"
      ]
    },
    "L2": {
      "authority": "The publication broker may push and open draft pull requests for R0 and R1; humans approve every merge.",
      "maximum_autonomous_mutation_risk": "R1",
      "minimum_governed_tasks": 30,
      "minimum_observation_days": 30,
      "name": "supervised-delivery",
      "nonhuman_capability_ceiling": [
        "repository.read",
        "task_clone.write",
        "candidate.execute",
        "git.commit",
        "task.admit",
        "lease.manage",
        "capability.grant",
        "evidence.attest",
        "audit.append",
        "github.push",
        "github.pull_request.create"
      ],
      "promotion_approvals": 2,
      "rank": 2,
      "required_controls": [
        "worker-identity-boundary",
        "private-task-clone",
        "default-deny-runtime",
        "lease-revocation",
        "independent-verification",
        "repository-rules",
        "sha-bound-publication",
        "capability-broker",
        "append-only-audit"
      ]
    },
    "L3": {
      "authority": "R0 and R1 may auto-merge after independent verification and review; R2 and R3 remain human-approved.",
      "maximum_autonomous_mutation_risk": "R1",
      "minimum_governed_tasks": 100,
      "minimum_observation_days": 60,
      "minimum_repositories": 3,
      "name": "bounded-autonomy",
      "nonhuman_capability_ceiling": [
        "repository.read",
        "task_clone.write",
        "candidate.execute",
        "git.commit",
        "task.admit",
